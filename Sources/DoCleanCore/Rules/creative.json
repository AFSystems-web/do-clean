 {
  "id": "blender-temp-renders",
  "tier": "green",
  "category": "creative",
  "palette": "system",
  "title": {
   "ru": "Blender: временные рендеры",
   "en": "Blender: temp renders"
  },
  "subtitle": {
   "ru": "/tmp/*.png, *.exr старше 1 дня",
   "en": "/tmp/*.png, *.exr older than 1 day"
  },
  "whySafe": {
   "ru": "Временные кадры рендера в /tmp. Готовые рендеры лежат в папке вывода проекта.",
   "en": "Temporary render frames in /tmp. Finished renders live in the project's output folder."
  },
  "roots": [
   "/tmp"
  ],
  "itemMode": "files",
  "patterns": [
   "*.png",
   "*.exr"
  ],
  "recursive": false,
  "minAgeDays": 1,
  "requiresAppClosed": [
   "org.blenderfoundation.blender"
  ]
 },
